<?xml version="1.0"?>
<ruleset name="Testimonial Rotator Reborn">
  <description>Advisory standards review of inherited code; not the CI release gate.</description>
  <file>.</file>
  <exclude-pattern>/.git/*</exclude-pattern>
  <exclude-pattern>/dist/*</exclude-pattern>
  <exclude-pattern>/tests/*</exclude-pattern>
  <arg name="extensions" value="php"/>
  <config name="minimum_wp_version" value="6.9.4"/>
  <config name="testVersion" value="7.4-8.3"/>
  <rule ref="WordPress-Extra">
    <!-- Match the four-space THRG house style used by Stickies. -->
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <exclude name="Universal.WhiteSpace.PrecisionAlignment"/>
  </rule>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array"><element value="testimonial-rotator"/></property>
    </properties>
  </rule>
  <rule ref="PHPCompatibilityWP"/>
</ruleset>
